# Copy this file to .env and fill in the values locally. Never commit .env.
SECRET_KEY=
DEBUG=
DATABASE_URL=
ALLOWED_HOSTS=

# Email. In development the console backend prints emails, so these can stay
# empty; set them in production (SMTP) to send real email.
DEFAULT_FROM_EMAIL=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=

# Khalti sandbox. Get a test secret key from the Khalti merchant dashboard.
KHALTI_BASE_URL=
KHALTI_SECRET_KEY=

# Production only (leave empty in development).
# The https origin(s) of the live site, comma-separated, for CSRF.
CSRF_TRUSTED_ORIGINS=
# S3-compatible media storage (e.g. Cloudflare R2). Leave empty to use the disk.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
